# Required — the whole engine depends on this one
ANTHROPIC_API_KEY=

# Salt for hashing usernames at ingestion. Any random string; keep it out of git.
AUTHOR_HASH_SALT=

# Optional. Reddit collector is skipped if absent — Play Store alone is enough for a working corpus.
# Create at https://www.reddit.com/prefs/apps  (type: script)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=blinkit-discovery/0.1

# Optional. YouTube comment collector is skipped if absent.
YOUTUBE_API_KEY=
