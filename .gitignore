.env
__pycache__/
*.py[cod]
.venv/
venv/

# Raw snapshots are large and regenerable — keep them local.
data/raw/*.jsonl
!data/raw/seed/

# The normalized corpus IS committed. It is a few MB, and it is the handoff:
# collection happens on your machine, analysis happens here.
!data/interim/documents.jsonl
!data/interim/relevance.jsonl
!data/interim/extractions.jsonl

data/processed/*.db

# Interview material never leaves the machine unanonymised
research/transcripts/*.raw.*
*.mp4
*.m4a

node_modules/
.next/
.DS_Store
